---
// gavinf.com — fully static. This page has no interactive state, so it ships
// no JavaScript at all; Clerk only loads on /auth and /dash.
//
// The job of this page is to say what the domain is in about five seconds and
// then hand the visitor somewhere better. Detail about the infrastructure
// belongs on docs.gavinf.com, not here.
import Base from '../layouts/Base.astro';

const DESTINATIONS = [
  {
    label: 'gavinfancher.com',
    note: 'Projects and writing',
    href: 'https://gavinfancher.com',
  },
  {
    label: 'docs.gavinf.com',
    note: 'Notes on the plumbing behind this',
    href: 'https://docs.gavinf.com',
  },
  {
    label: 'GitHub',
    note: '@gavinfancher',
    href: 'https://github.com/gavinfancher',
  },
  {
    label: 'LinkedIn',
    note: 'in/gavinfancher',
    href: 'https://linkedin.com/in/gavinfancher',
  },
];
---
<Base
  title="Gavin Fancher — data systems & infrastructure"
  description="gavinf.com is the control plane for a self-hosted mini-cloud: VM provisioning, private mesh networking, and public ingress, run on my own hardware."
>
  <div class="land-shell">
    <header class="land-header">
      <div class="land-logo-mark">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M17.5 19a4.5 4.5 0 0 0 .5-8.97A6 6 0 0 0 6.34 9.5 4 4 0 0 0 7 19z"
            stroke="#3fd79a" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <a class="btn-login" href="https://auth.gavinf.com">Login</a>
    </header>

    <main class="land-doc">
      <p class="land-eyebrow">Data systems · Data infrastructure</p>
      <h1 class="land-title">Gavin Fancher</h1>
      <p class="land-lead">I build data pipelines, systems, and infrastructure.</p>

      <p class="land-body">
        This domain isn't a portfolio — it's the control plane for a homelab I run
        as a small cloud, on my own hardware. Look at some of the resouces below, as 
        the control plane is behind an auth layer.
      </p>

      <nav class="land-dests" aria-label="Elsewhere">
        {DESTINATIONS.map((d) => (
          <a class="land-dest" href={d.href} target="_blank" rel="noopener noreferrer">
            <span class="land-dest-label">
              {d.label}
              <svg class="land-dest-arrow" width="13" height="13" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2.2"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17 17 7M9 7h8v8"/>
              </svg>
            </span>
            <span class="land-dest-note">{d.note}</span>
          </a>
        ))}
      </nav>
    </main>
  </div>
</Base>
