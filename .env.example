# Clerk publishable key — use the same key as homecloud if you want shared sessions
# across gavinf.com, dash.gavinf.com, and mycloud.gavinf.com
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...

# Optional: deep link for the UniFi card on the dashboard. Left unset, the card
# points at https://unifi.ui.com and you pick the console there. Set it in an
# untracked .env.local — the deep link names your console id, and this repo is
# public.
# PUBLIC_UNIFI_URL=https://unifi.ui.com/consoles/<console-id>/network/default/dashboard
